{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["lhr1"],
  "crons": [{ "path": "/api/cron/monitor", "schedule": "0 6 * * *" }],
  "functions": {
    "app/api/model/[key]/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "app/api/cron/monitor/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/live/page.tsx": {
      "maxDuration": 30,
      "memory": 1024
    },
    "app/api/health/route.ts": {
      "maxDuration": 10,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
