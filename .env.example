# ---------------------------------------------------------------------------
# origination — environment configuration. Copy to .env.local and fill in.
# Everything is OPTIONAL: with nothing set, the app runs entirely on the two
# illustrative synthetic borrowers and the deterministic engine. No key is
# needed to demo Engine A, Engine B, the resolution ladder, or ProseGate.
# ---------------------------------------------------------------------------

# --- Companies House (real public data on the /live route) ------------------
# When set, the /live route fetches real UK company profiles and charges from
# Companies House. Financial lines (turnover, EBITDA, leverage) still abstain,
# because they live inside the accounts document, not the structured API - the
# app labels that honestly rather than inventing figures.
# Free key: register an application at
#   https://developer.company-information.service.gov.uk/
# (create a REST / Public Data API key). Auth is HTTP Basic, key as username.
CH_API_KEY=

# --- Pluggable parsing model (the "parsing engine") -------------------------
# OPTIONAL. Configures a model to extract facts from unstructured accounts
# documents. The engine is model-agnostic: use any Claude model, any
# OpenAI-compatible endpoint, or a local model - selected purely here.
# The model may only propose a figure it quotes verbatim from the source
# document; any figure whose quote is not found in the document is dropped,
# so a model in the loop cannot fabricate a number.
#
# LLM_PROVIDER   : anthropic | openai-compatible | none   (unset = disabled)
# LLM_MODEL      : model id (pluggable - swap freely)
# LLM_API_KEY    : provider secret (omit for a keyless local server)
# LLM_BASE_URL   : host override (providers append /v1/messages or /v1/chat/completions)
# LLM_MAX_TOKENS : integer, default 2048
#
# Example A - Claude (default model claude-opus-4-8):
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-opus-4-8
#   LLM_API_KEY=sk-ant-...
#
# Example B - a local model via Ollama (no key needed):
#   LLM_PROVIDER=openai-compatible
#   LLM_MODEL=llama3.1
#   LLM_BASE_URL=http://localhost:11434
#
# Example C - any OpenAI-compatible gateway (OpenAI, OpenRouter, Groq, Together, vLLM):
#   LLM_PROVIDER=openai-compatible
#   LLM_MODEL=<their-model-id>
#   LLM_API_KEY=<their-key>
#   LLM_BASE_URL=<their-base-url>
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=

# Durable persistence (optional). Without it, tear sheets are saved per-tenant in
# memory for the life of the process. Set a Postgres URL (e.g. Supabase) to make the
# workspace durable across restarts and to ENFORCE row-level security. Apply the
# migrations in order: db/migrations/0001_init.sql .. 0004_graph.sql.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Authentication + the MNPI wall -----------------------------------------
# AUTH_SECRET: the signing secret for the session cookie and token fingerprints.
# MANDATORY in production - the app refuses to sign/verify a session without a
# strong, non-default value (a forged cookie would otherwise bypass the tenant
# wall). Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# AUTH_REQUIRED=1 removes the anonymous per-browser tenant, so every request must
# carry a signed-in session. Leave unset for the open demo; set it (with a real
# Postgres + the migrations applied) for a multi-tenant deployment.
AUTH_REQUIRED=

# --- Hosted preview and production (WP-DS01, WP-DS04, WP-DS08) --------------
# Names only. Check a file with:  npx tsx scripts/preflight.ts --env-file <file>
# docs/release/cam-steps.md says where each value comes from.

# The other production-required secrets (lib/config/prodGuard.ts). Generate each
# with:  openssl rand -base64 48
SHARED_HASH_PEPPER=
CRON_SECRET=
SHARED_ADMIN_SECRET=

# The app's database URL, as app_user (no superuser, no BYPASSRLS, owns no table).
# The app reads it before DATABASE_URL and POSTGRES_URL, so the owner URL the Neon
# integration injects never wins. Set in Vercel, Preview and Production scopes.
APP_DATABASE_URL=

# LOCAL ONLY. Never in Vercel. The Neon owner URL, used by scripts/db-migrate.ts to
# apply migrations and db/roles.sql.
OWNER_DATABASE_URL=

# LOCAL ONLY. Never in Vercel. When set, db-migrate sets app_user's password to it.
APP_USER_PASSWORD=

# Shared cache and rate limits. Set by the Upstash integration in Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Mail (WP-DS08). Resend is the chosen provider. The key is a sending-only key
# limited to the brand domain. From values take "Name <address>" or a bare address.
RESEND_API_KEY=
MAIL_FROM_INVITES=
MAIL_FROM_DEMO=
# The inbox that receives demo requests.
MAIL_DEMO_INBOX=

# LOCAL ONLY. For scripts/smoke-prod.ts on the machine that runs it. Not app variables.
# SMOKE_BYPASS_TOKEN is the project's Protection Bypass for Automation secret.
SMOKE_EMAIL=
SMOKE_PASSWORD=
SMOKE_BYPASS_TOKEN=

# The non-launch routes (list in lib/config/launchRoutes.ts) answer 404 in production and show in
# dev. 1 brings them back anywhere; 0 hides them in dev too. Leave unset for the default.
SHOW_NON_LAUNCH_ROUTES=
